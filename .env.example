# Ajuste os valores para o seu ambiente antes de iniciar os containers.
POSTGRES_DB=leilao_dev
POSTGRES_USER=app
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql+psycopg://app:change_me@postgres:5432/leilao_dev

PROJECT_NAME=LeiloesEliteDev
PROJECT_VERSION=1.0.0
# Substitua por uma chave aleatoria longa antes de usar fora do ambiente local.
SECRET_KEY=replace_with_a_long_random_secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Configure a URL real da API de itens externos antes de sincronizar o catalogo.
API_EXTERNA_URL="https://api.artic.edu/api/v1/artworks/search?query[exists][field]=image_id&fields=id,title,artist_display,date_display,main_reference_number,image_id,short_description"
SYNC_ITENS_INTERVAL_SECONDS=900
AUCTION_CLOSE_CHECK_INTERVAL_SECONDS=1
FRONTEND_ORIGINS=["http://localhost:5173"]

# URL acessada pelo navegador, portanto use localhost (ou o dominio publico), nao o nome do servico Docker.
VITE_API_URL=http://localhost:8000/api/v1

